{
  "name": "3s-gym-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8089 --clear",
    "android": "expo start --android --port 8089",
    "ios": "expo start --ios --port 8089",
    "web": "expo start --web --port 8089",
    "ldplayer": "adb shell am start -a android.intent.action.VIEW -d exp://192.168.1.17:8089 host.exp.exponent",
