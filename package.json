    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-font": "^57.0.4",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "^57.0.10",
    "expo-notifications": "~57.0.20",
